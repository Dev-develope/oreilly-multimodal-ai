LIVEKIT_URL=<your LiveKit server URL>
LIVEKIT_API_KEY=<your API Key>
LIVEKIT_API_SECRET=<your API Secret>
# 60dB AI provider (STT + LLM + TTS). Required for the default agent.py config.
SIXTYDB_API_KEY=<your 60dB API key>
SIXTYDB_BASE_URL=https://api.60db.ai/v1
# Optional fallback providers (only if you switch agent.py back to them):
OPENAI_API_KEY=<press Enter for now and edit .env.local>
DEEPGRAM_API_KEY=<press Enter for now and edit .env.local>
